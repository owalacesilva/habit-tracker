# Copy to .env.local (git-ignored). `make env` does this for you.

# --- Data source ----------------------------------------------------------
# Where user data lives. `indexeddb` makes the app autonomous: it stores
# everything in the browser, needs no backend and works offline. `api` points
# the same repository at an external service. `memory` is volatile (tests).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so a
# production image must be REBUILT to switch — restarting is not enough.
NEXT_PUBLIC_DATA_SOURCE=indexeddb
# Required when the data source is `api`.
NEXT_PUBLIC_API_URL=

# --- NextAuth -------------------------------------------------------------
# Only used when NEXT_PUBLIC_DATA_SOURCE=api. In local mode there is nothing
# to authenticate against, so the login screen is skipped entirely.
# Generate with: make secret
AUTH_SECRET=replace-me-with-a-32-byte-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Demo credentials provider -------------------------------------------
# Seed account used by the credentials provider until a real database exists.
DEMO_USER_EMAIL=demo@habit.app
DEMO_USER_PASSWORD=demo1234
DEMO_USER_NAME=Budi

# --- Optional OAuth -------------------------------------------------------
# The GitHub provider is registered only when both values are present.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Settings screen ------------------------------------------------------
# Store listing opened by "Rate the app". Empty → the button explains that
# ratings arrive once the app is published.
NEXT_PUBLIC_APP_STORE_URL=
# Recipient of "Send feedback" (opens the user's mail client).
NEXT_PUBLIC_FEEDBACK_EMAIL=feedback@habit.app

# --- Manual testing -------------------------------------------------------
# Fixture data seeded for the demo user, so every screen can be exercised in a
# known state: demo | empty | starter | regular | power
MOCK_PERSONA=demo

# --- Runtime --------------------------------------------------------------
APP_PORT=3000
